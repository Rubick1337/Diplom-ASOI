<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.1"
  xmlns:xmi="http://schema.omg.org/spec/XMI/2.1"
  xmlns:uml="http://schema.omg.org/spec/UML/2.1.2">

  <xmi:Documentation exporter="Enterprise Architect" exporterVersion="6.5"/>

  <!--
    Boundary Class Diagram — GooseCode Platform
    Стереотип закодирован в имени через «», чтобы избежать
    ошибки пустого поля AppliesTo.
  -->

  <uml:Model xmi:type="uml:Model" name="GooseCode_BoundaryClasses" visibility="public">
    <packagedElement xmi:type="uml:Package" xmi:id="pkg_boundary" name="Boundary Classes" visibility="public">

    <!-- ═══════════════════════════════════════════════════════ MainPage -->
    <packagedElement xmi:type="uml:Class" xmi:id="bnd_MainPage" name="MainPage" visibility="public">
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_main_1" name="«navbar» Header с логотипом и навигацией" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_main_2" name="«video» Фоновое видео" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_main_3" name="«section» Секция Hero (заголовок, подзаголовок)" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_main_4" name="«button» Войти" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_main_5" name="«button» Зарегистрироваться" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_main_6" name="«section» Секция возможностей платформы" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_main_7" name="«card» Карточки особенностей" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_main_8" name="«link» Перейти к задачам" visibility="public" isUnique="true" isOrdered="false"/>
    </packagedElement>

    <!-- ═══════════════════════════════════════════════════════ LoginPage -->
    <packagedElement xmi:type="uml:Class" xmi:id="bnd_LoginPage" name="LoginPage" visibility="public">
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_login_1" name="«navbar» AuthHeader" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_login_2" name="«video» Фоновое видео" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_login_3" name="«form» LoginForm" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_login_4" name="«input» Логин или Email" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_login_5" name="«input» Пароль" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_login_6" name="«button» Показать/скрыть пароль" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_login_7" name="«button» Войти" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_login_8" name="«button» Войти через Google" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_login_9" name="«button» Войти через GitHub" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_login_10" name="«link» Нет аккаунта? Зарегистрироваться" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_login_11" name="«alert» Сообщение об ошибке" visibility="public" isUnique="true" isOrdered="false"/>
    </packagedElement>

    <!-- ═══════════════════════════════════════════════════════ RegisterPage -->
    <packagedElement xmi:type="uml:Class" xmi:id="bnd_RegisterPage" name="RegisterPage" visibility="public">
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_reg_1"  name="«navbar» AuthHeader" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_reg_2"  name="«video» Фоновое видео" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_reg_3"  name="«form» RegisterForm (шаг 1 — данные)" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_reg_4"  name="«input» Имя пользователя" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_reg_5"  name="«input» Email" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_reg_6"  name="«input» Пароль" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_reg_7"  name="«input» Подтверждение пароля" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_reg_8"  name="«button» Показать/скрыть пароль" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_reg_9"  name="«button» Зарегистрироваться" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_reg_10" name="«alert» Сообщение об ошибке формы" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_reg_11" name="«form» VerifyForm (шаг 2 — подтверждение email)" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_reg_12" name="«info» Письмо с кодом отправлено на email" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_reg_13" name="«input» Код подтверждения из email" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_reg_14" name="«button» Подтвердить" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_reg_15" name="«button» Отправить код повторно" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_reg_16" name="«alert» Код устарел или истёк" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_reg_17" name="«alert» Неверный код подтверждения" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_reg_18" name="«link» Уже есть аккаунт? Войти" visibility="public" isUnique="true" isOrdered="false"/>
    </packagedElement>

    <!-- ═══════════════════════════════════════════════════════ ChallengesPage -->
    <packagedElement xmi:type="uml:Class" xmi:id="bnd_ChallengesPage" name="ChallengesPage" visibility="public">
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_chs_1"  name="«navbar» Header" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_chs_2"  name="«input» Поиск задачи" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_chs_3"  name="«select» Фильтр по теме" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_chs_4"  name="«select» Фильтр по сложности" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_chs_5"  name="«select» Сортировка" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_chs_6"  name="«button» Применить фильтры" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_chs_7"  name="«button» Сбросить фильтры" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_chs_8"  name="«list» Список карточек задач" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_chs_9"  name="«card» ChallengeItem (название, сложность, теги, рейтинг)" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_chs_10" name="«range» Ползунок сложности (RandomChallenge)" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_chs_11" name="«button» Перейти к задаче (RandomChallenge)" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_chs_12" name="«pagination» Пагинация" visibility="public" isUnique="true" isOrdered="false"/>
    </packagedElement>

    <!-- ═══════════════════════════════════════════════════════ ChallengePage -->
    <packagedElement xmi:type="uml:Class" xmi:id="bnd_ChallengePage" name="ChallengePage" visibility="public">
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_ch_1"  name="«navbar» Header" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_ch_2"  name="«panel» Описание задачи (название, условие, примеры)" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_ch_3"  name="«tabs» Вкладки (Описание / Отзывы / Решения сообщества)" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_ch_4"  name="«select» Выбор языка программирования (LanguageSelect)" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_ch_5"  name="«editor» Monaco Editor (редактор кода)" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_ch_6"  name="«button» Форматировать код" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_ch_7"  name="«button» Отправить решение" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_ch_8"  name="«panel» Результаты тестов (статус, ожидаемо, получено, время)" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_ch_9"  name="«textarea» Поле для отзыва" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_ch_10" name="«rating» Шкала оценки (1-5 звёзд)" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_ch_11" name="«button» Оставить отзыв" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_ch_12" name="«list» Список решений сообщества" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_ch_13" name="«vote» Кнопки голосования за решение (лайк / дизлайк)" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_ch_14" name="«counter» Счётчик голосов решения" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_ch_15" name="«list» Комментарии к решению" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_ch_16" name="«input» Поле ввода комментария" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_ch_17" name="«button» Отправить комментарий" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_ch_18" name="«button» Удалить комментарий" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_ch_19" name="«button» Помощник ИИ" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_ch_20" name="«button» Пожаловаться" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_ch_21" name="«modal» ReportModal (причина + описание)" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_ch_22" name="«overlay» LockedOverlay (для неавторизованных)" visibility="public" isUnique="true" isOrdered="false"/>
    </packagedElement>

    <!-- ═══════════════════════════════════════════════════════ ProfilePage -->
    <packagedElement xmi:type="uml:Class" xmi:id="bnd_ProfilePage" name="ProfilePage" visibility="public">
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_prof_1"  name="«navbar» Header" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_prof_2"  name="«sidebar» Аватар, имя, уровень, XP, рейтинг" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_prof_3"  name="«heatmap» Тепловая карта активности" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_prof_4"  name="«tabs» Вкладки (История задач / История тестов / Жалобы / Статистика / Обучение / Достижения)" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_prof_5"  name="«table» Таблица истории решений задач" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_prof_6"  name="«code» Блок кода решения (подсветка синтаксиса, тема по текущей теме UI)" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_prof_7"  name="«input» Поиск по истории" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_prof_8"  name="«select» Фильтр по статусу" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_prof_9"  name="«select» Фильтр по языку" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_prof_10" name="«pagination» Пагинация истории" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_prof_11" name="«table» Таблица истории прохождения тестов" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_prof_12" name="«table» Таблица жалоб" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_prof_13" name="«chart» Графики статистики (языки, темы, успешность)" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_prof_14" name="«progress» Прогресс по темам" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_prof_15" name="«list» Рекомендации" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_prof_16" name="«button» Сгенерировать гайд по теме" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_prof_17" name="«card» Гайд по теме (концепции, путь, связанные темы)" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_prof_18" name="«grid» Сетка достижений (разблокированные / заблокированные)" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_prof_19" name="«badge» Карточка достижения (название, редкость, дата получения)" visibility="public" isUnique="true" isOrdered="false"/>
    </packagedElement>

    <!-- ═══════════════════════════════════════════════════════ LeaderboardPage -->
    <packagedElement xmi:type="uml:Class" xmi:id="bnd_LeaderboardPage" name="LeaderboardPage" visibility="public">
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_lb_1" name="«navbar» Header" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_lb_2" name="«input» Поиск пользователя" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_lb_3" name="«select» Сортировка (рейтинг / опыт)" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_lb_4" name="«select» Направление сортировки" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_lb_5" name="«table» Таблица лидеров (место, имя, рейтинг, опыт, решено)" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_lb_6" name="«pagination» Пагинация" visibility="public" isUnique="true" isOrdered="false"/>
    </packagedElement>

    <!-- ═══════════════════════════════════════════════════════ AdminPage -->
    <packagedElement xmi:type="uml:Class" xmi:id="bnd_AdminPage" name="AdminPage" visibility="public">
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_adm_1"  name="«navbar» Header" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_adm_2"  name="«tabs» Вкладки (Reports / Manage / Topics / Achievements / Tests)" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_adm_3"  name="«stats» Статистика жалоб (по статусу, по причине)" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_adm_4"  name="«table» Таблица жалоб" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_adm_5"  name="«select» Фильтр жалоб по статусу" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_adm_6"  name="«select» Фильтр жалоб по причине" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_adm_7"  name="«input» Фильтр по дате (от / до)" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_adm_8"  name="«button» Применить фильтры" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_adm_9"  name="«button» Resolved / Dismissed" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_adm_10" name="«table» Таблица задач (Manage)" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_adm_11" name="«input» Поиск задачи" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_adm_12" name="«select» Фильтр по теме" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_adm_13" name="«menu» Меню строки (Редактировать / Скрыть / Удалить)" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_adm_14" name="«button» + Добавить задачу" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_adm_15" name="«table» Таблица тем (Topics)" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_adm_16" name="«input» Новая тема" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_adm_17" name="«button» + Добавить / Изменить / Удалить тему" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_adm_18" name="«table» Таблица достижений (Achievements)" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_adm_19" name="«form» Форма создания/редактирования достижения" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_adm_20" name="«upload» Загрузка иконки достижения" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_adm_21" name="«button» + Добавить достижение" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_adm_22" name="«table» Таблица тестов (Tests)" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_adm_23" name="«button» + Создать тест" visibility="public" isUnique="true" isOrdered="false"/>
      <ownedAttribute xmi:type="uml:Property" xmi:id="a_adm_24" name="«button» Публикация / Снять с публикации / Редактировать / Удалить тест" visibility="public" isUnique="true" isOrdered="false"/>
