        <ownedAttribute xmi:type="uml:Property" xmi:id="A_SC_createdAt"  name="createdAt"  visibility="public" type="PT_Date"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_SC_updatedAt"  name="updatedAt"  visibility="public" type="PT_Date"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="O_SC_create" name="create" visibility="public">
          <ownedParameter xmi:type="uml:Parameter" xmi:id="P_SC_cr_solutionId" name="solutionId" type="PT_Integer" direction="in"/>
          <ownedParameter xmi:type="uml:Parameter" xmi:id="P_SC_cr_userId"     name="userId"     type="PT_Integer" direction="in"/>
          <ownedParameter xmi:type="uml:Parameter" xmi:id="P_SC_cr_content"    name="content"    type="PT_Text"    direction="in"/>
        </ownedOperation>
        <ownedOperation xmi:type="uml:Operation" xmi:id="O_SC_getAll" name="getAll" visibility="public">
          <ownedParameter xmi:type="uml:Parameter" xmi:id="P_SC_ga_solutionId" name="solutionId" type="PT_Integer" direction="in"/>
          <ownedParameter xmi:type="uml:Parameter" xmi:id="P_SC_ga_query"      name="query"      type="PT_String"  direction="in"/>
        </ownedOperation>
        <ownedOperation xmi:type="uml:Operation" xmi:id="O_SC_delete" name="delete" visibility="public">
          <ownedParameter xmi:type="uml:Parameter" xmi:id="P_SC_del_id"     name="id"     type="PT_Integer" direction="in"/>
          <ownedParameter xmi:type="uml:Parameter" xmi:id="P_SC_del_userId" name="userId" type="PT_Integer" direction="in"/>
        </ownedOperation>
      </packagedElement>

      <!-- ══════════════════════════════════════════════════════════
           SolutionVote
      ══════════════════════════════════════════════════════════ -->
      <packagedElement xmi:type="uml:Class" xmi:id="C_SolutionVote" name="SolutionVote">
