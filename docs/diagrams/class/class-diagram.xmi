          <ownedParameter xmi:type="uml:Parameter" xmi:id="P_SV_up_userId"     name="userId"     type="PT_Integer" direction="in"/>
          <ownedParameter xmi:type="uml:Parameter" xmi:id="P_SV_up_vote"       name="vote"       type="PT_Integer" direction="in"/>
