        <ownedAttribute xmi:type="uml:Property" xmi:id="A_Q_points"        name="points"        visibility="public" type="PT_Float"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_Q_order"         name="order"         visibility="public" type="PT_Integer"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_Q_allowMultiple" name="allowMultiple" visibility="public" type="PT_Boolean"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_Q_caseSensitive" name="caseSensitive" visibility="public" type="PT_Boolean"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_Q_tolerance"     name="tolerance"     visibility="public" type="PT_Float"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_Q_codeLanguage"  name="codeLanguage"  visibility="public" type="PT_String"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_Q_starterCode"   name="starterCode"   visibility="public" type="PT_Text"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_Q_funcName"      name="funcName"      visibility="public" type="PT_String"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="O_Q_create" name="create" visibility="public">
          <ownedParameter xmi:type="uml:Parameter" xmi:id="P_Q_cr_data" name="data" type="PT_String" direction="in"/>
