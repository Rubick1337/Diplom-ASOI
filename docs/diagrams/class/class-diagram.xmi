        <ownedAttribute xmi:type="uml:Property" xmi:id="A_SV_solutionId" name="solutionId" visibility="public" type="PT_Integer"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_SV_userId"     name="userId"     visibility="public" type="PT_Integer"/>
