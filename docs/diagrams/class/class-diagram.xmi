<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.1"
         xmlns:uml="http://www.omg.org/spec/UML/20090901"
         xmlns:xmi="http://www.omg.org/spec/XMI/20090901">

  <xmi:Documentation exporter="GooseCode" exporterVersion="2.0"/>

  <uml:Model xmi:type="uml:Model" xmi:id="MODEL_GooseCode" name="GooseCode">
    <packagedElement xmi:type="uml:Package" xmi:id="PKG_Domain" name="Domain">

      <!-- Primitive Types -->
      <packagedElement xmi:type="uml:PrimitiveType" xmi:id="PT_Integer" name="INTEGER"/>
      <packagedElement xmi:type="uml:PrimitiveType" xmi:id="PT_String"  name="STRING"/>
      <packagedElement xmi:type="uml:PrimitiveType" xmi:id="PT_Text"    name="TEXT"/>
      <packagedElement xmi:type="uml:PrimitiveType" xmi:id="PT_Boolean" name="BOOLEAN"/>
      <packagedElement xmi:type="uml:PrimitiveType" xmi:id="PT_Float"   name="FLOAT"/>
      <packagedElement xmi:type="uml:PrimitiveType" xmi:id="PT_Date"    name="DATE"/>

      <!-- в•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђ
           Role
      в•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђ -->
      <packagedElement xmi:type="uml:Class" xmi:id="C_Role" name="Role">
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_Role_id"   name="id"   visibility="public" type="PT_Integer"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_Role_name" name="name" visibility="public" type="PT_String"/>
      </packagedElement>

      <!-- в•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђ
           User
      в•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђ -->
      <packagedElement xmi:type="uml:Class" xmi:id="C_User" name="User">
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_User_id"           name="id"           visibility="public" type="PT_Integer"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_User_username"     name="username"     visibility="public" type="PT_String"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_User_email"        name="email"        visibility="public" type="PT_String"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_User_password"     name="password"     visibility="public" type="PT_String"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_User_roleId"       name="roleId"       visibility="public" type="PT_Integer"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_User_refreshToken" name="refreshToken" visibility="public" type="PT_String"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_User_googleId"     name="googleId"     visibility="public" type="PT_String"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_User_githubId"     name="githubId"     visibility="public" type="PT_String"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_User_experience"   name="experience"   visibility="public" type="PT_Integer"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_User_rating"       name="rating"       visibility="public" type="PT_Integer"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="O_User_register" name="register" visibility="public">
          <ownedParameter xmi:type="uml:Parameter" xmi:id="P_User_reg_username" name="username" type="PT_String"  direction="in"/>
          <ownedParameter xmi:type="uml:Parameter" xmi:id="P_User_reg_email"    name="email"    type="PT_String"  direction="in"/>
          <ownedParameter xmi:type="uml:Parameter" xmi:id="P_User_reg_password" name="password" type="PT_String"  direction="in"/>
        </ownedOperation>
        <ownedOperation xmi:type="uml:Operation" xmi:id="O_User_login" name="login" visibility="public">
          <ownedParameter xmi:type="uml:Parameter" xmi:id="P_User_login_email"    name="email"    type="PT_String" direction="in"/>
          <ownedParameter xmi:type="uml:Parameter" xmi:id="P_User_login_password" name="password" type="PT_String" direction="in"/>
        </ownedOperation>
        <ownedOperation xmi:type="uml:Operation" xmi:id="O_User_logout" name="logout" visibility="public">
          <ownedParameter xmi:type="uml:Parameter" xmi:id="P_User_logout_token" name="refreshToken" type="PT_String" direction="in"/>
        </ownedOperation>
        <ownedOperation xmi:type="uml:Operation" xmi:id="O_User_refresh" name="refresh" visibility="public">
          <ownedParameter xmi:type="uml:Parameter" xmi:id="P_User_refresh_token" name="refreshToken" type="PT_String" direction="in"/>
        </ownedOperation>
        <ownedOperation xmi:type="uml:Operation" xmi:id="O_User_updateUser" name="updateUser" visibility="public">
          <ownedParameter xmi:type="uml:Parameter" xmi:id="P_User_upd_id"   name="id"   type="PT_Integer" direction="in"/>
          <ownedParameter xmi:type="uml:Parameter" xmi:id="P_User_upd_data" name="data" type="PT_String"  direction="in"/>
        </ownedOperation>
        <ownedOperation xmi:type="uml:Operation" xmi:id="O_User_loginWithGoogle" name="loginWithGoogle" visibility="public">
          <ownedParameter xmi:type="uml:Parameter" xmi:id="P_User_google_profile" name="profile" type="PT_String" direction="in"/>
        </ownedOperation>
        <ownedOperation xmi:type="uml:Operation" xmi:id="O_User_loginWithGithub" name="loginWithGithub" visibility="public">
          <ownedParameter xmi:type="uml:Parameter" xmi:id="P_User_github_profile" name="profile" type="PT_String" direction="in"/>
        </ownedOperation>
        <ownedOperation xmi:type="uml:Operation" xmi:id="O_User_generateTokens" name="generateTokens" visibility="public">
          <ownedParameter xmi:type="uml:Parameter" xmi:id="P_User_gen_payload" name="payload" type="PT_String" direction="in"/>
        </ownedOperation>
        <ownedOperation xmi:type="uml:Operation" xmi:id="O_User_validateAccessToken" name="validateAccessToken" visibility="public">
          <ownedParameter xmi:type="uml:Parameter" xmi:id="P_User_valAccess_token" name="token" type="PT_String" direction="in"/>
        </ownedOperation>
        <ownedOperation xmi:type="uml:Operation" xmi:id="O_User_validateRefreshToken" name="validateRefreshToken" visibility="public">
          <ownedParameter xmi:type="uml:Parameter" xmi:id="P_User_valRefresh_token" name="token" type="PT_String" direction="in"/>
        </ownedOperation>
      </packagedElement>

      <!-- в•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђ
           Challenge
      в•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђ -->
      <packagedElement xmi:type="uml:Class" xmi:id="C_Challenge" name="Challenge">
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_Ch_id"              name="id"              visibility="public" type="PT_Integer"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_Ch_name"            name="name"            visibility="public" type="PT_String"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_Ch_description"     name="description"     visibility="public" type="PT_Text"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_Ch_difficulty"      name="difficulty"      visibility="public" type="PT_Integer"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_Ch_mode"            name="mode"            visibility="public" type="PT_String"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_Ch_funcName"        name="funcName"        visibility="public" type="PT_String"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_Ch_timeLimitMs"     name="timeLimitMs"     visibility="public" type="PT_Integer"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_Ch_createdByUserId" name="createdByUserId" visibility="public" type="PT_Integer"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_Ch_sampleInput"     name="sampleInput"     visibility="public" type="PT_Text"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_Ch_sampleOutput"    name="sampleOutput"    visibility="public" type="PT_Text"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_Ch_isHidden"        name="isHidden"        visibility="public" type="PT_Boolean"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="O_Ch_create" name="create" visibility="public">
          <ownedParameter xmi:type="uml:Parameter" xmi:id="P_Ch_create_data" name="data" type="PT_String" direction="in"/>
        </ownedOperation>
        <ownedOperation xmi:type="uml:Operation" xmi:id="O_Ch_getAll" name="getAll" visibility="public">
          <ownedParameter xmi:type="uml:Parameter" xmi:id="P_Ch_getAll_query" name="query" type="PT_String" direction="in"/>
        </ownedOperation>
        <ownedOperation xmi:type="uml:Operation" xmi:id="O_Ch_getById" name="getById" visibility="public">
          <ownedParameter xmi:type="uml:Parameter" xmi:id="P_Ch_getById_id" name="id" type="PT_Integer" direction="in"/>
        </ownedOperation>
        <ownedOperation xmi:type="uml:Operation" xmi:id="O_Ch_update" name="update" visibility="public">
          <ownedParameter xmi:type="uml:Parameter" xmi:id="P_Ch_upd_id"   name="id"   type="PT_Integer" direction="in"/>
          <ownedParameter xmi:type="uml:Parameter" xmi:id="P_Ch_upd_data" name="data" type="PT_String"  direction="in"/>
        </ownedOperation>
        <ownedOperation xmi:type="uml:Operation" xmi:id="O_Ch_delete" name="delete" visibility="public">
          <ownedParameter xmi:type="uml:Parameter" xmi:id="P_Ch_del_id" name="id" type="PT_Integer" direction="in"/>
        </ownedOperation>
        <ownedOperation xmi:type="uml:Operation" xmi:id="O_Ch_execute" name="execute" visibility="public">
          <ownedParameter xmi:type="uml:Parameter" xmi:id="P_Ch_exec_challengeId" name="challengeId" type="PT_Integer" direction="in"/>
          <ownedParameter xmi:type="uml:Parameter" xmi:id="P_Ch_exec_code"        name="code"        type="PT_Text"    direction="in"/>
          <ownedParameter xmi:type="uml:Parameter" xmi:id="P_Ch_exec_language"    name="language"    type="PT_String"  direction="in"/>
          <ownedParameter xmi:type="uml:Parameter" xmi:id="P_Ch_exec_userId"      name="userId"      type="PT_Integer" direction="in"/>
        </ownedOperation>
        <ownedOperation xmi:type="uml:Operation" xmi:id="O_Ch_verify" name="verify" visibility="public">
          <ownedParameter xmi:type="uml:Parameter" xmi:id="P_Ch_verify_data"     name="data"     type="PT_String" direction="in"/>
          <ownedParameter xmi:type="uml:Parameter" xmi:id="P_Ch_verify_code"     name="code"     type="PT_Text"   direction="in"/>
          <ownedParameter xmi:type="uml:Parameter" xmi:id="P_Ch_verify_language" name="language" type="PT_String" direction="in"/>
        </ownedOperation>
        <ownedOperation xmi:type="uml:Operation" xmi:id="O_Ch_formatCode" name="formatCode" visibility="public">
          <ownedParameter xmi:type="uml:Parameter" xmi:id="P_Ch_fmt_code"     name="code"     type="PT_Text"   direction="in"/>
          <ownedParameter xmi:type="uml:Parameter" xmi:id="P_Ch_fmt_language" name="language" type="PT_String" direction="in"/>
        </ownedOperation>
        <ownedOperation xmi:type="uml:Operation" xmi:id="O_Ch_getCommunitySolutions" name="getCommunitySolutions" visibility="public">
          <ownedParameter xmi:type="uml:Parameter" xmi:id="P_Ch_cs_challengeId" name="challengeId" type="PT_Integer" direction="in"/>
          <ownedParameter xmi:type="uml:Parameter" xmi:id="P_Ch_cs_userId"      name="userId"      type="PT_Integer" direction="in"/>
          <ownedParameter xmi:type="uml:Parameter" xmi:id="P_Ch_cs_options"     name="options"     type="PT_String"  direction="in"/>
        </ownedOperation>
      </packagedElement>

      <!-- в•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђ
           Topic
      в•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђ -->
      <packagedElement xmi:type="uml:Class" xmi:id="C_Topic" name="Topic">
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_Topic_id"   name="id"   visibility="public" type="PT_Integer"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_Topic_name" name="name" visibility="public" type="PT_String"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="O_Topic_getAll" name="getAll" visibility="public"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="O_Topic_create" name="create" visibility="public">
          <ownedParameter xmi:type="uml:Parameter" xmi:id="P_Topic_create_name" name="name" type="PT_String" direction="in"/>
        </ownedOperation>
        <ownedOperation xmi:type="uml:Operation" xmi:id="O_Topic_update" name="update" visibility="public">
          <ownedParameter xmi:type="uml:Parameter" xmi:id="P_Topic_upd_id"   name="id"   type="PT_Integer" direction="in"/>
          <ownedParameter xmi:type="uml:Parameter" xmi:id="P_Topic_upd_name" name="name" type="PT_String"  direction="in"/>
        </ownedOperation>
        <ownedOperation xmi:type="uml:Operation" xmi:id="O_Topic_delete" name="delete" visibility="public">
          <ownedParameter xmi:type="uml:Parameter" xmi:id="P_Topic_del_id" name="id" type="PT_Integer" direction="in"/>
        </ownedOperation>
      </packagedElement>

      <!-- в•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђ
           ChallengeTopic
      в•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђ -->
      <packagedElement xmi:type="uml:Class" xmi:id="C_ChallengeTopic" name="ChallengeTopic">
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_CT_challengeId" name="challengeId" visibility="public" type="PT_Integer"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_CT_topicId"     name="topicId"     visibility="public" type="PT_Integer"/>
      </packagedElement>

      <!-- в•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђ
           ChallengeParameter
      в•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђ -->
      <packagedElement xmi:type="uml:Class" xmi:id="C_ChallengeParameter" name="ChallengeParameter">
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_CP_id"          name="id"          visibility="public" type="PT_Integer"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_CP_challengeId" name="challengeId" visibility="public" type="PT_Integer"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_CP_name"        name="name"        visibility="public" type="PT_String"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_CP_dataType"    name="dataType"    visibility="public" type="PT_String"/>
      </packagedElement>

      <!-- в•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђ
           ChallengeTestCase
      в•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђ -->
      <packagedElement xmi:type="uml:Class" xmi:id="C_ChallengeTestCase" name="ChallengeTestCase">
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_CTC_id"             name="id"             visibility="public" type="PT_Integer"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_CTC_challengeId"    name="challengeId"    visibility="public" type="PT_Integer"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_CTC_title"          name="title"          visibility="public" type="PT_String"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_CTC_expectedOutput" name="expectedOutput" visibility="public" type="PT_Text"/>
      </packagedElement>

      <!-- в•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђ
           TestCaseArgument
      в•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђ -->
