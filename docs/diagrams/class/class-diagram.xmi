        <ownedAttribute xmi:type="uml:Property" xmi:id="A_QTC_order"          name="order"          visibility="public" type="PT_Integer"/>
      </packagedElement>

      <!-- в•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђ
           TestAttempt
      в•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђ -->
      <packagedElement xmi:type="uml:Class" xmi:id="C_TestAttempt" name="TestAttempt">
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_TA_id"         name="id"         visibility="public" type="PT_Integer"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_TA_testId"     name="testId"     visibility="public" type="PT_Integer"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_TA_userId"     name="userId"     visibility="public" type="PT_Integer"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_TA_startedAt"  name="startedAt"  visibility="public" type="PT_Date"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_TA_finishedAt" name="finishedAt" visibility="public" type="PT_Date"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_TA_status"     name="status"     visibility="public" type="PT_String"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_TA_score"      name="score"      visibility="public" type="PT_Float"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_TA_maxScore"   name="maxScore"   visibility="public" type="PT_Float"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="O_TA_start" name="start" visibility="public">
          <ownedParameter xmi:type="uml:Parameter" xmi:id="P_TA_st_testId" name="testId" type="PT_Integer" direction="in"/>
          <ownedParameter xmi:type="uml:Parameter" xmi:id="P_TA_st_userId" name="userId" type="PT_Integer" direction="in"/>
        </ownedOperation>
        <ownedOperation xmi:type="uml:Operation" xmi:id="O_TA_submit" name="submit" visibility="public">
          <ownedParameter xmi:type="uml:Parameter" xmi:id="P_TA_sub_attemptId" name="attemptId" type="PT_Integer" direction="in"/>
        </ownedOperation>
        <ownedOperation xmi:type="uml:Operation" xmi:id="O_TA_timeout" name="timeout" visibility="public">
          <ownedParameter xmi:type="uml:Parameter" xmi:id="P_TA_to_attemptId" name="attemptId" type="PT_Integer" direction="in"/>
        </ownedOperation>
        <ownedOperation xmi:type="uml:Operation" xmi:id="O_TA_getResult" name="getResult" visibility="public">
          <ownedParameter xmi:type="uml:Parameter" xmi:id="P_TA_gr_attemptId" name="attemptId" type="PT_Integer" direction="in"/>
        </ownedOperation>
      </packagedElement>

      <!-- в•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђ
           AttemptQuestion
      в•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђ -->
      <packagedElement xmi:type="uml:Class" xmi:id="C_AttemptQuestion" name="AttemptQuestion">
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_AQ_id"         name="id"         visibility="public" type="PT_Integer"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_AQ_attemptId"  name="attemptId"  visibility="public" type="PT_Integer"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_AQ_questionId" name="questionId" visibility="public" type="PT_Integer"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_AQ_position"   name="position"   visibility="public" type="PT_Integer"/>
      </packagedElement>

      <!-- в•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђ
           AttemptAnswer
      в•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђ -->
      <packagedElement xmi:type="uml:Class" xmi:id="C_AttemptAnswer" name="AttemptAnswer">
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_AA_id"           name="id"           visibility="public" type="PT_Integer"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_AA_attemptId"    name="attemptId"    visibility="public" type="PT_Integer"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_AA_questionId"   name="questionId"   visibility="public" type="PT_Integer"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_AA_answerText"   name="answerText"   visibility="public" type="PT_Text"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_AA_codeAnswer"   name="codeAnswer"   visibility="public" type="PT_Text"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_AA_isCorrect"    name="isCorrect"    visibility="public" type="PT_Boolean"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_AA_pointsEarned" name="pointsEarned" visibility="public" type="PT_Float"/>
        <ownedOperation xmi:type="uml:Operation" xmi:id="O_AA_save" name="save" visibility="public">
          <ownedParameter xmi:type="uml:Parameter" xmi:id="P_AA_save_data" name="data" type="PT_String" direction="in"/>
        </ownedOperation>
        <ownedOperation xmi:type="uml:Operation" xmi:id="O_AA_evaluate" name="evaluate" visibility="public">
          <ownedParameter xmi:type="uml:Parameter" xmi:id="P_AA_eval_answer"   name="answer"   type="PT_String" direction="in"/>
          <ownedParameter xmi:type="uml:Parameter" xmi:id="P_AA_eval_question" name="question" type="PT_String" direction="in"/>
        </ownedOperation>
      </packagedElement>

      <!-- в•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђ
           AnswerSelectedOption
      в•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђ -->
      <packagedElement xmi:type="uml:Class" xmi:id="C_AnswerSelectedOption" name="AnswerSelectedOption">
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_ASO_id"       name="id"       visibility="public" type="PT_Integer"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_ASO_answerId" name="answerId" visibility="public" type="PT_Integer"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_ASO_optionId" name="optionId" visibility="public" type="PT_Integer"/>
      </packagedElement>

      <!-- в•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђ
           AnswerMatchingPair
      в•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђ -->
      <packagedElement xmi:type="uml:Class" xmi:id="C_AnswerMatchingPair" name="AnswerMatchingPair">
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_AMP_id"        name="id"        visibility="public" type="PT_Integer"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_AMP_answerId"  name="answerId"  visibility="public" type="PT_Integer"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_AMP_optionId"  name="optionId"  visibility="public" type="PT_Integer"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_AMP_matchPair" name="matchPair" visibility="public" type="PT_Text"/>
      </packagedElement>

      <!-- в•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђ
           AnswerTestCaseResult
      в•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђв•ђ -->
      <packagedElement xmi:type="uml:Class" xmi:id="C_AnswerTestCaseResult" name="AnswerTestCaseResult">
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_ATCR_id"             name="id"             visibility="public" type="PT_Integer"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_ATCR_answerId"       name="answerId"       visibility="public" type="PT_Integer"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_ATCR_position"       name="position"       visibility="public" type="PT_Integer"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_ATCR_input"          name="input"          visibility="public" type="PT_Text"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_ATCR_expectedOutput" name="expectedOutput" visibility="public" type="PT_Text"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_ATCR_actualOutput"   name="actualOutput"   visibility="public" type="PT_Text"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_ATCR_passed"         name="passed"         visibility="public" type="PT_Boolean"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_ATCR_isHidden"       name="isHidden"       visibility="public" type="PT_Boolean"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_ATCR_timedOut"       name="timedOut"       visibility="public" type="PT_Boolean"/>
        <ownedAttribute xmi:type="uml:Property" xmi:id="A_ATCR_error"          name="error"          visibility="public" type="PT_Text"/>
      </packagedElement>

      <!-- ══════════════════════════════════════════════════════════
           SolutionComment
      ══════════════════════════════════════════════════════════ -->
      <packagedElement xmi:type="uml:Class" xmi:id="C_SolutionComment" name="SolutionComment">
