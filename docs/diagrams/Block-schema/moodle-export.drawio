      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />

        <!-- Терминалы: x=270, w=160, h=50 -->
        <!-- Прямоугольники: x=240, w=220, h=60 -->
        <!-- Ромбы: x=250, w=200, h=90 -->
